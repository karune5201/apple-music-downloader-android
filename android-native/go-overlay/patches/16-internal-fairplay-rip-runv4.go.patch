+// 知道里面真有几个分片，而且环形表的空槽、滑动播放列表回绕后的顺序都得自己
+// 收拾。把 len(Segments) 当分片数，每一首都会以
+// "playlist=1024 fragments=7" 的形态失败。
+//
+// 按 SeqId 排序是为了滑动播放列表：回绕之后数组下标的顺序和播放顺序不一致。
+func playlistSegments(p *m3u8.MediaPlaylist) []*m3u8.MediaSegment {
+	if p == nil {

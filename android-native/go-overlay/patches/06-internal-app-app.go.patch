+
+// askForInput 在等待 stdin 之前先发一行 ##prompt 协议标记。
+//
+// 标记是语言无关的：Android 端看到它就弹出输入/选择界面；
+// 人看到的仍是紧接着的那行翻译好的提示（只带颜色，不加级别标记）。
+func askForInput(promptColor *color.Color, prompt string) {
+	logx.Print("##prompt\n")
+	promptColor.Print(prompt)
+}
